      {
        "collapsed": false,
        "content": "def merge(intervals):\n    result = []\n    for start, end in sorted(intervals):\n        if result and start < result[-1][1]:\n            left, right = result[-1]\n            result[-1] = (left, max(right, end))\n        else:\n            result.append((start, end))\n    return result",
        "id": "cd582372-f809-4708-a0c7-a2a5ce09f92d",
        "isError": false,
        "ordinal": 62,
        "role": "tool",
