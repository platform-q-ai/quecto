# This project's standard development container — a STARTER, and yours.
#
# `quecto container init` wrote this file because none existed. From here on
# it belongs to this repository: edit it, commit it, and the next agent in
# this folder gets the same container. quecto never counts it as drift and
# never replaces it (`init --refresh` restores only the runtime scripts
# beside it). `/setup container` can write the toolchain section for you.
#
# The runtime script, not this image, clones the configured repository and
# mounts that checkout; source and credentials are never baked in. Build the
# image with the command `quecto container init` prints; create never pulls
# or builds it.
FROM docker.io/library/debian@sha256:abc9cb88a5587630d7f915f47b23b0668fe250fbfc6457aa4d52b534c1bbf73f

ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="Project development container"

# What every agent needs whatever the project is: a shell, git and GitHub,
# search, JSON, Python for scripts, a C toolchain for native dependencies.
RUN apt-get update \
 && apt-get install --no-install-recommends --yes \
      bash build-essential ca-certificates coreutils curl fd-find findutils \
      git gh grep jq less openssh-client procps python3 python3-venv \
      ripgrep sed \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/fdfind /usr/local/bin/fd

# --- This project's toolchain -------------------------------------------
# Install what the project builds and tests with, pinned where the project
# pins it (its CI configuration is the best guide), for example:
#
#   RUN apt-get update && apt-get install --yes --no-install-recommends \
#         nodejs npm && rm -rf /var/lib/apt/lists/*
#
# Then declare the tools an agent must find on PATH. `quecto container
# doctor` runs the image and fails, naming the tool, if one is missing. Bare
# executable names separated by spaces; without the label nothing beyond a
# shell and git is asked of the image.
#
#   LABEL ai.quecto.required-tools="node npm"

# The host-side adapter supplies the child command and mounts its checkout.
ENTRYPOINT []
CMD []
WORKDIR /workspace
